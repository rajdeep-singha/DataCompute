# Rabdi writer. Fund this address at https://hub.arkiv.network/faucet
PRIVATE_KEY=0x

# Optional. The public RPC works without it and is rate limited.
# Create one at https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=

# Shown in the UI so queries keep only this wallet's checks.
# `npm run verify` prints the address derived from PRIVATE_KEY.
VITE_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional overrides.
ETH_RPC_URL=https://ethereum.publicnode.com
VITE_ARKIV_ACCESS_KEY=

# Marketplace relayer. The server writes listings/purchases as PRIVATE_KEY above.
PORT=8787

# Optional. Enables WalletConnect wallets; MetaMask/injected works without it.
# Create one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Watcher wallet whose upgrade alerts the page shows. `npm run watch` prints it.
VITE_WATCHER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional Swarm bonus. Run `bee dev` (free dev-mode postage stamp, no BZZ) and
# set this so the watcher pins each alert's evidence bundle to Swarm.
BEE_API_URL=

# Optional. Point at Aethera's server/data folder to serve its live oracle
# snapshots; unset, a real bundled snapshot is used so the demo always works.
AETHERA_DATA_DIR=
