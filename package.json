{
  "name": "dataverify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "On-chain token checks, stored as expiring Arkiv entities and queried by anyone.",
  "license": "MIT",
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.106.1",
    "@types/express": "^5.0.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "viem": "^2.38.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:all": "tsx watch server/index.ts & vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "verify": "tsx src/verify.ts",
    "watch": "tsx src/watch.ts",
    "query": "tsx src/query.ts",
    "query:alerts": "tsx src/query-alerts.ts",
    "seed:aethera": "tsx src/seed-aethera.ts",
    "seed:market": "tsx src/seed-providers.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "diamond:pin": "tsx src/diamond-pin.ts",
    "diamond:check": "tsx src/diamond-check.ts",
    "test": "tsx --test src/lib/checks/checks.test.ts src/lib/diamond/compare.test.ts src/lib/notifications/*.test.ts",
    "monitor": "tsx src/monitor.ts",
    "telegram": "tsx src/telegram.ts"
  },
  "engines": {
    "node": ">=22.13"
  }
}
